// Conversation drill-in page mock data
// =====================================================================
// Consumed by src/views/home_conversation.html.
//
// The `conversations` registry lives in index.json — the source of
// truth for the Seller Home surface whose review cards link here. This
// page pulls it at build time via the `readData("index")` Nunjucks
// global (defined in gulpfile.js) so a card and the thread it opens
// can't drift apart.
//
// Fields owned by THIS file:
//   • pageTitle             — <title>/aria label for the page.
//   • defaultConversationId — fallback when the URL has no `?id=`.
//                             Matches the first seeded entry in
//                             index.json's `conversations` map. The
//                             conversation page uses this to render a
//                             sensible default view instead of an
//                             empty shell.
//   • fallbackTitle         — placeholder title when the conversation
//                             id from the URL isn't in the registry.
//                             Phase 1 renders placeholders; a later
//                             phase will hydrate real content.
//   • composerPlaceholder   — Figma copy for the sticky-bottom input.
//   • thinkingLabel         — default copy inside the agent's thinking
//                             indicator. A scripted turn can override
//                             it per-turn (see `scriptedTurns` in
//                             index.json).
{
  "pageTitle": "Conversation",
  "defaultConversationId": "conv-001",
  // Last-resort heading when `?id=` is missing or unknown. An inline
  // boot script on the page rewrites the <h1> from the URL (and a
  // compact id → title map) before first paint, so other threads no
  // longer flash this string. home_conversation.js then re-applies
  // the same heading (idempotent).
  "fallbackTitle": "Found new prospects",
  "composerPlaceholder": "Ask Hunter a follow up\u2026",
  "thinkingLabel": "Thinking\u2026"
}
