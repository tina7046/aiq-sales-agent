{
  // Facts + timed beat-script for the /running_lab.html workbench.
  // This drives the ~1-minute simulation of the completed "Found new
  // prospects" run (index.json → feed ri-01 → conversations["conv-001"]).
  //
  // gulp injects each top-level key here as a template variable in
  // running_lab.html. running_lab.html serialises `run` into a global
  // (window.RUNNING_LAB_RUN) that running_lab.js walks beat by beat, so
  // the reasoning steps live in data rather than hardcoded in JS.
  //
  // The chain-of-thought vocabulary (ICP dimensions, 🔴/🟡/🚫 tiers,
  // 🟣/🔵 fit, dedup, cadence quality-checklist, "drafts only") is drawn
  // from the real agent trace at
  //   /Users/nmotamedi/Documents/protos/account-prospect-table/run_output.json
  // and the entities (Bluebirds, Cirrus, Marcus Chen, …) from conv-001.

  "task": {
    "id": "ri-01",
    "title": "Finding new prospects",
    "cadence": "Weekly",
    "startedAt": "Run Started"
  },

  "run": {
    // Base dwell per beat (ms). ~24 beats ⇒ ≈ 1 minute wall-clock.
    "beatMs": 2100,
    // Pause between phases as one collapses and the next activates.
    "phaseGapMs": 700,
    // Terminal summary shown in the status box + accordion header when the
    // run completes. Mirrors conv-001's activity chip
    // ("25 prospects · 7 accounts · 25 drafts").
    "summary": "7 accounts · 25 prospects · 25 cadences",
    // The conversation whose finished result is revealed at the end.
    "revealConversationId": "conv-001",

    "phases": [
      {
        "key": "research",
        "icon": "search",
        "name": "Research Accounts",
        // Header shimmer while this phase is active. Resting `name` returns
        // once the phase completes.
        "running": "Researching accounts…",
        "summary": "47 scanned · 7 qualified",
        "beats": [
          { "thought": "Reading your Ideal Customer Profile",
            "tools": [ { "icon": "knowledge_base", "label": "Ideal Customer Profile", "count": "8 dimensions" } ] },
          { "thought": "Pulling your Bluebirds Account Report from Salesforce",
            "tools": [ { "icon": "table", "label": "Salesforce report", "count": "47 accounts" } ] },
          { "thought": "Enriching firmographics — industry, size, revenue, geography",
            "tools": [ { "icon": "database", "label": "ZoomInfo enrichment", "count": "47 matched" },
                       { "icon": "world",    "label": "Web research",        "count": "31 results" } ] },
          { "thought": "Scoring Cirrus — B2B SaaS, 290+ SDRs across 4 regions → 🔴 Red Hot" },
          { "thought": "Brightloop AI — Series C, scaling outbound → 🔴 Red Hot" },
          { "thought": "Meridian Analytics — RevOps modernization signal → 🟡 Solid",
            "tools": [ { "icon": "ai_search", "label": "Gong call signals", "count": "6 calls" } ] },
          { "thought": "Halcyon Foods — CPG, not B2B SaaS · fails 7 of 8 ICP dimensions — discarding 🚫" },
          { "thought": "Northbend Logistics — no outbound motion detected — discarding 🚫" },
          { "thought": "Writing a one-line fit rationale for each qualified account" }
        ]
      },
      {
        "key": "prospects",
        "icon": "people",
        "name": "Find Prospects",
        "running": "Finding prospects…",
        "summary": "7 accounts · 25 prospects",
        "beats": [
          { "thought": "Finding up to 5 decision-makers at each qualified account" },
          { "thought": "Matching titles to your buyer personas — CRO, VP Sales, RevOps, Demand Gen",
            "tools": [ { "icon": "org_chart", "label": "Org charts", "count": "7 accounts" } ] },
          { "thought": "Enriching Marcus Chen — VP Sales at Cirrus",
            "tools": [ { "icon": "database",   "label": "ZoomInfo — email, mobile, LinkedIn", "count": "verified" },
                       { "icon": "socialshare", "label": "LinkedIn",                          "count": "matched" } ] },
          { "thought": "Scoring Marcus Chen → 🟣 Great fit · accuracy 94" },
          { "thought": "Validating employment — still at Cirrus ✓",
            "tools": [ { "icon": "identity", "label": "Employment check", "count": "current" } ] },
          { "thought": "Deduping against existing CRM contacts — 3 already exist, excluded",
            "tools": [ { "icon": "search", "label": "Salesforce contacts", "count": "3 matched" } ] },
          { "thought": "Dropping opted-out and recently-engaged contacts" },
          { "thought": "Creating new Contacts in Salesforce",
            "tools": [ { "icon": "contact", "label": "Contacts created", "count": "25 new" } ] }
        ]
      },
      {
        "key": "cadences",
        "icon": "email",
        "name": "Draft Cadences",
        "running": "Drafting cadences…",
        "summary": "25 cadences · 3 emails each",
        "beats": [
          { "thought": "Drafting a 3-email cadence per prospect",
            "tools": [ { "icon": "knowledge_base", "label": "SDR playbook", "count": "loaded" } ] },
          { "thought": "Email 1 for Marcus Chen — signal: 290+ SDRs across 4 regions" },
          { "thought": "Personalizing on signals, pain themes, and persona",
            "tools": [ { "icon": "ai_search", "label": "Gong pain themes", "count": "matched" } ] },
          { "thought": "Adding follow-ups — Day 3 nudge, Day 7 breakup" },
          { "thought": "Checking the quality checklist — POV → Pain → Solution → CTA, under 120 words ✓" },
          { "thought": "Saving drafts as Salesforce Tasks",
            "tools": [ { "icon": "email", "label": "Email drafts saved", "count": "75 tasks" } ] },
          { "thought": "Drafts only — nothing sent without your approval" }
        ]
      }
    ]
  }
}
