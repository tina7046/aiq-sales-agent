        },
        {
          "id": "hs-gov",
          "type": "insight",
          "severity": "warning",
          "heading": "Governance and schedule",
          "text": "Hunter will **not** write to CRM without an explicit rep-side approval, and will **not** send email on a rep's behalf — only drafts held for review. PII redaction applies at ingest and inference. You can pause any workflow globally or per rep from Home at any time.",
          "bottomLine": "**Kickoff:** immediately on approval. **Duration:** 3–4 hours. Hunter DMs you when Phase 1 completes, then again when Phase 2 completes so you can review org-level learnings and roll out to reps.",
          "footnote": "On approval this plan is snapshotted as the org's Hunter configuration record, then the learning job starts."
        },
