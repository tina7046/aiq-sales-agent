      "messages": [
        {
          "id": "hs-lead",
          "type": "agent",
          "text": "Here's a **draft plan** to finish configuring Hunter for your org, Nima. Hunter will learn your GTM motion from **decision traces on real opportunities** — steering toward the most recent deals from your strongest sellers and healthiest customers. Nothing starts until you approve."
        },
        {
          "id": "hs-sources",
          "type": "insight",
          "severity": "positive",
          "heading": "Data already ingested",
          "text": "Hunter used this corpus to draft the plan. Approval kicks off the long-running learning job on top of it.",
          "tableTitle": "Sources",
          "table": {
            "id": "hs-sources-table",
            "ariaLabel": "Ingested data sources",
            "columns": [
              {
                "id": "source",
                "label": "Source"
              },
              {
                "id": "volume",
                "label": "Volume"
              },
              {
                "id": "window",
                "label": "Window"
              }
            ],
            "rows": [
              {
                "id": "hs-src-crm",
                "source": "CRM",
                "volume": "3,412 opps · 18,204 activities · 172 users",
                "window": "24 months"
              },
              {
                "id": "hs-src-email",
                "source": "Email",
                "volume": "1.2M messages · 172 mailboxes",
                "window": "12 months"
              },
              {
                "id": "hs-src-meetings",
