{
  // Defaults for the Memory calendar prototype.
  // Leave `buckets` empty (or omit it) to generate synthetic counts for
  // the current grain + timeframe. When grain AND timeframe match, a
  // non-empty buckets array is used as-is — any grain, not only days.
  "cal": {
    "grain": "day",
    "timeframe": "90d",
    "cellSize": 24,
    "palette": "custom",
    // Layout. Omit or null = Auto (day → 7-row heatmap; week/month → 1 row).
    // Set one: that axis is fixed, the other is computed from the buckets.
    // Set both: a cols × rows board, padded with empty squares if needed.
    "cols": 15,
    "rows": null,
    "buckets": []
  }
}
