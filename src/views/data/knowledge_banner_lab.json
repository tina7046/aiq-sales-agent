{
  // Knowledge banner LAB — content for /knowledge_banner_lab.html
  // ===================================================================
  // A copy of the `banner` object in knowledge.json. Gulp binds this
  // file to the page on the filename match, same as every other lab.
  //
  // It's a copy rather than a read of the real one so the lab can hold
  // stress cases the live page shouldn't — a title that wraps to three
  // lines, an empty `stats` array, a long button label. Change copy
  // here freely; it can't reach the demo.
  banner: {
    badge: 'New',
    title: 'Turn Learning into Doing, Automatically',
    description: 'With Auto-Learning, your agent learns from product docs, call transcripts, and site content to generate prospects, draft emails, and build skills that help you work smarter.',
    stats: [
      'Ran for 2 days and 18 hours',
      'Read 1,468 call recordings and 10,822 emails'
    ],
    buttonLabel: 'Got it'
  },

  // Filler rows under the banner. They exist so the dismiss has
  // something to move: the second half of that gesture is everything
  // below the banner gliding up into its space, which is invisible on a
  // page where the banner is the only thing there.
  //
  // Deliberately not the real doc list — what's being designed here is
  // the banner, and copying the list would be one more thing to keep in
  // sync for no benefit.
  filler: [
    'Customer Business Problem',
    'Competitive Landscape',
    'Discovery Call Framework',
    'Pricing and Packaging',
    'Security and Compliance FAQ',
    'Onboarding Playbook'
  ]
}
