        "completed": {
          "heading": "All 25 drafts approved",
          "body": "The approved drafts will be released to the configured outreach workflow."
        }
      }
    },
    // ── conv-002 — the Seller Home composer's landing thread ─────────
    // Where `composer.submitTarget` sends the seller after they type on
    // Home and hit Send. Deliberately its OWN entry rather than a second
    // door into conv-001: the two answer different questions (that one
    // reviews prepared outreach; this one reads the pipeline), so the
    // copy here can change without touching the Ready to Review
    // drill-in.
    //
    // Written against one question — "What are the top 3 things I must
    // know to make my number?" — because that's the demo. `?q=` puts the
    // seller's actual words at the top of the thread and in the header;
    // this is the agent's side of it. Typing something else still works,
    // it just gets this answer.
    //
    // The three findings use the `insight` message type: a ranked
    // headline with a triage dot, the evidence under it, and the
    // takeaway. Prose fields accept `**bold**` and `_italic_` (see the
    // `emphasis` filter in gulpfile.js), so the copy stays readable
    // here instead of carrying HTML.
    "conv-002": {
      "id": "conv-002",
      "title": "Pipeline reality check",
      "subtitle": "Pipeline Review",
      "workflow": { "id": "pipeline_review", "label": "Pipeline Review" },
      "status": "in_progress",
      "recentLabel": "Pipeline reality check",
      "messages": [
        {
          "id":   "c2-intro",
          "type": "agent",
          "text": "I\u2019ll pull your current pipeline data right now to give you the three most critical things you need to know to hit your number. Let me grab your open opportunities and recent win/loss data."
        },
        {
          "id":   "c2-lead",
          "type": "agent",
          "text": "Here are the **3 things you need to know right now** to make your numbers. Today is the last day of July \u2014 this is your end-of-month reality check."
        },
        {
          "id":       "c2-insight-1",
          "type":     "insight",
          "severity": "critical",
          "rank":     1,
          "heading":  "You have $126M+ in slipped deals \u2014 the close dates already passed",
          "text":     "These deals were supposed to close **this month** but are still open, many in early stages. This is the biggest red flag in your pipeline:",
          "tableTitle": "Slipped Deals \u2014 Close Date Already Passed",
          // `tone` on a cell colors that value alone. Used here for the
          // silences that make a row indefensible, not for every number
          // in the column — if they were all red, none of them would be.
          "table": {
            "id": "c2-slipped-deals",
            "ariaLabel": "Slipped deals whose close date has already passed",
            "columns": [
              { "id": "deal",       "label": "Deal"        },
              { "id": "amount",     "label": "Amount",      "align": "right" },
              { "id": "stage",      "label": "Stage"       },
              { "id": "daysSilent", "label": "Days Silent", "align": "right" }
            ],
            "rows": [
              { "id": "sd-01", "deal": "ServiceNow - CX",              "amount": "$14.6M", "stage": "Prospecting",         "daysSilent": "27" },
              { "id": "sd-02", "deal": "Appian - Enterprise",          "amount": "$14.2M", "stage": "Qualification",       "daysSilent": { "value": "Never", "tone": "critical" } },
              { "id": "sd-03", "deal": "Veeva - Cloud Migration",      "amount": "$14.2M", "stage": "Perception Analysis", "daysSilent": { "value": "80", "tone": "critical" } },
              { "id": "sd-04", "deal": "CrowdStrike - Data Analytics", "amount": "$13.6M", "stage": "Value Proposition",   "daysSilent": "17" },
              { "id": "sd-05", "deal": "Plaid - DevOps",               "amount": "$13.2M", "stage": "Needs Analysis",      "daysSilent": "34" },
              { "id": "sd-06", "deal": "Stripe - Integration Suite",   "amount": "$12.9M", "stage": "Needs Analysis",      "daysSilent": { "value": "69", "tone": "warning" } },
              { "id": "sd-07", "deal": "Confluent - CX",               "amount": "$12.8M", "stage": "Prospecting",         "daysSilent": "39" },
              { "id": "sd-08", "deal": "Gong - Platform License",      "amount": "$12.1M", "stage": "Qualification",       "daysSilent": { "value": "47", "tone": "warning" } }
            ]
          },
          "bottomLine": "**Bottom line:** These deals have unrealistic close dates for their stage \u2014 a $14.6M deal still in _Prospecting_ can\u2019t close today. They need to be re-dated or disqualified to get an honest forecast."
        },
        {
          "id":       "c2-insight-2",
          "type":     "insight",
          "severity": "warning",
          "rank":     2,
          "heading":  "Your best bets for _actual_ revenue are 3 deals worth ~$25M weighted",
          "text":     "Only a handful of July deals have both high probability AND recent activity:",
          "tableTitle": "Best Bets \u2014 50%+ Probability With Recent Engagement",
          "table": {
            "id": "c2-best-bets",
            "ariaLabel": "Best bets: deals over 50% probability with recent engagement",
            "columns": [
              { "id": "deal",      "label": "Deal"       },
              { "id": "amount",    "label": "Amount",     "align": "right" },
              { "id": "prob",      "label": "Prob",       "align": "right" },
              { "id": "weighted",  "label": "Weighted",   "align": "right" },
              { "id": "lastTouch", "label": "Last Touch" }
            ],
            "rows": [
              { "id": "bb-01", "deal": "HashiCorp - DevOps",           "amount": "$11.2M", "prob": "70%", "weighted": "$7.9M", "lastTouch": { "value": "Today", "tone": "positive" } },
              { "id": "bb-02", "deal": "CrowdStrike - Data Analytics", "amount": "$13.6M", "prob": "50%", "weighted": "$6.8M", "lastTouch": "Jul 14" },
              { "id": "bb-03", "deal": "Square - Integration Suite",   "amount": "$10.8M", "prob": "70%", "weighted": "$7.5M", "lastTouch": { "value": "Jun 21", "tone": "warning" } }
            ]
          },
          "bottomLine": "**Bottom line:** ~$22M weighted is what\u2019s actually _real_ this month. Everything else either has no recent activity or is stuck in an early stage. Push hard on these three today."
        },
        {
          "id":       "c2-insight-3",
          "type":     "insight",
          "severity": "positive",
          "rank":     3,
          "heading":  "Your win rate is strong (55% count / 75% by value) \u2014 leverage it",
          "stats": [
            {
              "label":  "Q3 Win Rate (by count)",
              "value":  "55%",
              "trend":  "up",
              "detail": "26 won vs 21 lost"
            },
            {
              "label":  "Q3 Win Rate (by value)",
              "value":  "75%",
              "trend":  "up",
              "detail": "$19.0M won vs $6.5M lost"
            }
          ],
          "footnote": "You\u2019re winning the _bigger_ deals when they close. The problem isn\u2019t conversion \u2014 it\u2019s **pipeline hygiene and velocity**. You have 2,500+ open opportunities, but many have no activity and unrealistic dates."
        },
        {
          "id":   "c2-activity",
          "type": "workflow_activity",
          "workflowLabel": "Pipeline review completed",
          "workflowIcon":  "apps",
          "statusText":    "2,500+ open opportunities \u00b7 8 slipped \u00b7 3 best bets"
        },
        {
          "id":   "c2-next-steps",
          "type": "suggestions",
          "text": "What do you want me to do next?",
          "items": [
            {
              "id":         "c2-fix-dates",
              "text":       "Re-date or disqualify the 8 slipped deals so the forecast is honest.",
              "boldPhrase": "8 slipped deals",
              "cta":        "Clean up the dates",
              "prompt":     "Re-date or disqualify the slipped deals"
            },
            {
              "id":     "c2-push-plan",
              "text":   "Build today\u2019s push plan for HashiCorp, CrowdStrike, and Square.",
              "cta":    "Draft the push plan",
              "prompt": "Build a push plan for HashiCorp, CrowdStrike, and Square"
            },
            {
              "id":         "c2-weekly-check",
              "text":       "I can also run this reality check every Monday morning and open with what moved.",
              "boldPhrase": "every Monday morning",
              "cta":        "Schedule it weekly",
              "prompt":     "Run this pipeline reality check every Monday morning"
            }
          ]
        }
      ],
      // Four beats, because the answer is an analysis and it should
      // look like one being done: pull the data, run it, check the
      // engagement, then compare wins and losses. The labels narrate
      // the same steps the answer describes itself taking.
      "opening": {
        "stages": [
          {
            "id": "c2-open-01",
            "thinkingMs": 1600,
            "thinkingLabel": "Pulling your open opportunities and win/loss data\u2026",
            "messageIds": ["c2-intro"]
          },
          {
            "id": "c2-open-02",
            "thinkingMs": 2400,
            "thinkingLabel": "Loading the pipeline review skill and running the analysis\u2026",
            "messageIds": ["c2-lead", "c2-insight-1"]
          },
          {
            "id": "c2-open-03",
            "thinkingMs": 2000,
            "thinkingLabel": "Checking probability against recent engagement\u2026",
            "messageIds": ["c2-insight-2"]
          },
          {
            "id": "c2-open-04",
            "thinkingMs": 1800,
            "thinkingLabel": "Comparing Q3 wins and losses\u2026",
            "messageIds": ["c2-insight-3", "c2-activity", "c2-next-steps"]
          }
        ]
      },
      // One turn so a follow-up send doesn't dead-end. Prose only —
      // the drafted-sequence card lives on conv-001, and pointing this
      // thread at it would mean a second copy of the cadence data.
      "scriptedTurns": [
        {
          "id": "c2-turn-01",
          "thinkingMs": 2200,
          "thinkingLabel": "Re-dating the slipped deals against their stage\u2026",
          "reply": [
            {
              "id":   "c2-turn-01-reply",
              "type": "agent",
              "text": "Working on it. I\u2019ll re-date the eight slipped deals against what stage they\u2019re actually in, flag the two with no activity at all as disqualification candidates, and bring the corrected forecast back here before anything changes in Salesforce."
            }
          ]
        }
      ]
    }
  },
  "review": {
    "heading": "Your path to quota",
    // Optional PIN for the date beside the heading. null = show today,
    // recomputed on every page load. Set a literal string ("Mon July 13")
    // to freeze it — useful when a screenshot has to match a deck.
    "date": null,
    "defaultTabId": "ready",
    // `label` is dormant while there's a single tab — the header renders
    // `heading` as a plain <h2>. Kept in step with it so restoring the
    // tablist (see _home_ready_to_review.html) doesn't resurrect the old
    // wording.
    "tabs": [
      { "id": "ready", "label": "Your path to quota", "dataKey": "reviewItems" }
    ],
    "overflowActions": [
      { "id": "view_all",        "label": "View all" },
      { "id": "review_settings", "label": "Review settings" }
    ],
    // Per-row overflow-menu actions rendered by the `reviewRow` macro.
    // Same { id, label, icon? } shape as `overflowActions` above so a
    // future consumer can share renderers between the section-level and
    // row-level menus. `icon` (optional) is an SLDS utility-sprite id.
    // Kept as one shared list rather than per-row overrides so every
    // card exposes the same action set — matches the Salesforce list-
    // interaction pattern where every row has an identical kebab menu.
    // Additional actions (Snooze, Assign, etc.) drop in as new entries
    // here without any template or JS changes.
    "rowActions": [
      { "id": "dismiss", "label": "Dismiss", "icon": "close" }
    ],
    // Semantic-category → SLDS utility-sprite map (Figma node
    // 8797:228978). Row outputs pick an `icon` from this map's
    // keys — the mapping to a concrete SLDS sprite lives here so
    // a design change that reskins "message" from `comments` to
    // `email` (or any other utility icon) is a single-line edit
    // that re-skins every message pill on the page. Categories:
    //   • table    — structured records / lists (prospects, buyers,
    //                accounts as list output)
    //   • message  — drafted outreach or replies
    //   • document — generated artifacts (briefs, next steps)
    //   • pdf      — polished, distributable reports
    //
    // Icon sourcing rules — same shape the nav item macro uses:
    //   • `sprite`        — SVG symbol id inside a `spriteFamily`
    //                        sprite. `spriteFamily` picks which
    //                        `assets/icons/<family>-sprite/svg/symbols.svg`
    //                        file to load from. Defaults to `utility`
    //                        for back-compat.
    //   • `iconImage`     — raster asset path used when no suitable
    //                        sprite exists (per-icon fallback). Wins
    //                        over `sprite` if both are set.
    //
    // Doctype sprites (`gsheet`, `txt`, `pdf`) are pre-colored — the
    // pill glyph CSS deliberately does NOT force a `currentColor`
    // fill on the SVG so these sprites paint themselves.
    "outputTypes": {
      "table":    { "sprite": "gsheet", "spriteFamily": "doctype" },
      "doc":      { "sprite": "gdoc",   "spriteFamily": "doctype" },
      "message":  { "sprite": "txt",    "spriteFamily": "doctype" },
      "document": { "iconImage": "/assets/images/output-icons/doc.png" },
      "pdf":      { "sprite": "pdf",    "spriteFamily": "doctype" }
    },
