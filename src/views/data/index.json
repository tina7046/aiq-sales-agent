          ],
          "footnote": "You\u2019re winning the _bigger_ deals when they close. The problem isn\u2019t conversion \u2014 it\u2019s **pipeline hygiene and velocity**. You have 2,500+ open opportunities, but many have no activity and unrealistic dates."
        },
        {
          "id":   "c2-activity",
          "type": "workflow_activity",
          "workflowLabel": "Pipeline review completed",
          "workflowIcon":  "apps",
          "statusText":    "2,500+ open opportunities \u00b7 8 slipped \u00b7 3 best bets"
        },
        {
          "id":   "c2-next-steps",
          "type": "suggestions",
          "text": "What do you want me to do next?",
          "items": [
            {
              "id":         "c2-fix-dates",
              "text":       "Re-date or disqualify the 8 slipped deals so the forecast is honest.",
              "boldPhrase": "8 slipped deals",
              "cta":        "Clean up the dates",
              "prompt":     "Re-date or disqualify the slipped deals"
            },
            {
              "id":     "c2-push-plan",
