      // One thing changed under it while it was parked: this card reads
      // `subject` / `body` off each prospect ROW, and the rows are now
      // the labs' generated dataset, which has no drafts. Unparking it
      // means authoring 25 or cutting the roster down first — the
      // cadence card that replaced it doesn't care, because it templates
      // its own copy from the identity fields.
      "_reviewParked": {
        "id": "conv-001-review",
        "channel": "email",
        "heading": "Outreach review",
        "confirmDialog": {
          "title": "Approve outreach to 25 prospects?",
          "body": "The approved drafts will be released to the configured outreach workflow.",
          "primary": "Approve 25 drafts",
          "secondary": "Cancel"
