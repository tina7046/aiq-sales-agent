// Seller Home mock data
// =====================================================================
// Consumed by src/views/home.html (which composes _home_left_nav.html).
// gulpfile.js's getData() auto-merges this file into the template's
// local scope by filename → template lookup.
//
// Fields:
//   • navPrimary  — the five top-level nav items above "Recents":
//                   New chat, Schedules, Skills, Knowledge, Tools.
//                   Each is { id, label, icon | iconImage, href? }.
//                   `icon` is the SLDS utility-sprite symbol id,
//                   resolved by _home_left_nav.html's renderNavItem
//                   macro to
//                   /assets/icons/utility-sprite/svg/symbols.svg#<icon>.
//                   `iconImage` is a raster asset used when no
//                   suitable sprite exists (see per-item comments
//                   inline where the array is defined).
//   • navActive   — id of the currently-active nav item. Default is
//                   "new_chat" since /home.html IS the new-chat landing.
//                   Pages that render a different Home sub-view (e.g. a
//                   future /home/workflows.html) should override this.
//   • recents     — the "Recents" scrollable list. Order = display
//                   order. Each { id, label }; no href yet — this is
//                   Phase 1, and clicking a recent doesn't route
//                   anywhere until the chat surface exists in Phase 2.
//                   The last few items intentionally trail past the
//                   scroll fade so the scroll affordance is visible
//                   without cheating.
//   • navFooter   — Feedback + Settings, pinned to the nav bottom by
//                   the .seller-home__nav-footer flex rule.
//   • briefing    — Phase 2 "Daily Briefing" content, consumed by the
//                   `.seller-home__briefing` block in home.html. The
//                   greeting is one editable string; every value in the
//                   sentence below it stays a discrete field so the
//                   block can later be re-hydrated from a live API
//                   without touching the template.
//                   Fields:
//                     - heading                (string) the full greeting
//                                              line, rendered as-is
//                     - text                   (string) the briefing
//                                              sentence, rendered as-is
//                     - linkPhrase             (string) substring of
//                                              `text` styled as a link
//                   The numeric fields below are dormant: the sentence
//                   used to interpolate them through popover-trigger
//                   buttons, and now states the numbers directly. They
//                   (and `popovers`) are kept so the linked version can
//                   be restored without re-authoring the data.
//                     - quotaPercent           (number, 0-100)
//                     - quarterDaysRemaining   (number, integer)
//                     - atRiskDeals.count      (number, integer)
//                     - atRiskDeals.valueUsd   (number, raw dollars)
//                     - atRiskDeals.valueLabel (string, display-ready)
//                     - reEngagedBuyers.count  (number, integer)
//                     - upcomingMeetings.count (number, integer)
//   • composer    — Phase 3 chat composer configuration. Everything
//                   the template needs to render icon buttons + the
//                   textarea placeholder lives here so labels can be
//                   localized and the icon set can be swapped without
//                   editing home.html. Fields:
//                     - placeholder            (string) fallback / reduced-
//                                              motion placeholder. Rendered
//                                              statically in the HTML so
//                                              users who prefer reduced
//                                              motion always see one clean
//                                              prompt without animation.
//                     - samplePrompts          (array<string>) full-string
//                                              placeholder cycle. home.js
//                                              types each prompt out
//                                              character-by-character on
//                                              the textarea's `placeholder`
//                                              attribute, holds, deletes,
//                                              and moves to the next.
//                                              Loops forever; halts the
//                                              moment the user actually
//                                              types real content into
//                                              the textarea. Bypassed
//                                              entirely when
//                                              `prefers-reduced-motion:
//                                              reduce` is set — the static
//                                              `placeholder` above is
//                                              shown instead.
//                     - ariaLabel              (string) main input label
//                     - actions.start[]        (array) left toolbar
//                     - actions.end[]          (array) right toolbar
//                                              (excludes Send — that's
//                                              the form's submit button,
//                                              not a peripheral action)
//                     Each action: { id, label, icon }.
//                     `icon` is an SLDS utility-sprite symbol id.
//
//   • review     — Phase 4 "Ready to Review" surface. Two independent
//                  row collections (`reviewItems` and `tasks`) live
//                  side-by-side so they can bind to different APIs
//                  later without renaming anything. Fields:
//                    - defaultTabId       (string)  initially-selected tab id
//                    - tabs[]             (array)   { id, label, dataKey }
//                                                   dataKey names the sibling
//                                                   array on `review` that
//                                                   supplies rows for the tab
//                    - overflowActions[]  (array)   { id, label } kebab menu
//                    - reviewItems[]      (array)   rows for Ready to Review
//                    - tasks[]            (array)   rows for Tasks
//                    - outputTypes        (object)  { <icon> →
//                                                     { sprite, spriteFamily?, iconImage? } }
//                                                   central registry mapping
//                                                   each SEMANTIC output
//                                                   category to its icon
//                                                   source. Categories are:
//                                                     • table    — lists /
//                                                                  records
//                                                     • message  — drafts
//                                                     • document — in-flight
//                                                                  artifacts
//                                                                  (briefs,
//                                                                  next steps)
//                                                     • pdf      — polished
//                                                                  reports
//                                                   Each entry supplies either
//                                                   an SLDS sprite id (with
//                                                   `spriteFamily` picking the
//                                                   sprite file — defaults to
//                                                   `utility`) or an
//                                                   `iconImage` raster path
//                                                   for bespoke glyphs. The
//                                                   template reads whichever
//                                                   is set and renders an
//                                                   <svg> or <img> accordingly.
//                                                   Design updates that reskin
//                                                   a category are a one-line
//                                                   edit here.
//                  Each row: { id, title, description,
//                              icon: { sprite },              ← SLDS 2 sprite name
//                              outputs?: [                    ← agentic output pills
//                                { icon, label } … ],        ← rendered under desc
//                              workflow?: { id, label } }     ← hover-reveal badge
//                  `outputs` (array) and `workflow` are both optional. If a
//                  row has no `outputs`, the third row inside the card is
//                  simply not emitted, and the card falls back to a compact
//                  two-row (title + description) layout at 56 px min-height.
//                  On each output entry:
//                    - `icon`  (string)  semantic category — one of the
//                                        keys defined in `outputTypes`
//                                        ("table" | "message" | "document"
//                                        | "pdf").
//                    - `label` (string)  full display text, count included
//                                        ("12 prospects", "3 meeting briefs").
//                                        Count is baked into the string so
//                                        the template stays a plain render
//                                        with no singularization logic.
//                  Icon COLOR is deliberately not in data — the SLDS 2
//                  standard-icon class (`slds-icon-standard-{sprite}`)
//                  supplies the canonical Salesforce object color via
//                  `--slds-c-icon-color-background`. Adding a color
//                  here would silently drift from SLDS 2 whenever the
//                  design system updates its palette. Output pills carry
//                  no per-type color at all (see Figma 8797:228978) —
//                  every pill is the same neutral chip in home.scss.
{
  "pageTitle": "Seller Home",
  "navActive": "new_chat",
  "briefing": {
    // Full greeting line, rendered verbatim — edit the whole sentence
    // here (including the time of day and the name).
    "heading": "You're almost there, Nima.",
    // The briefing sentence, also rendered verbatim. Numbers are baked into
    // the copy rather than interpolated from the fields below, so reword
    // freely without touching the template.
    "text": "You’re 76% to quota with 30 days left in the quarter. Here’s what to do to hit your goal of President’s Club.",
    // Substring of `text` to render with the interactive link treatment
    // (accent color, dotted underline that thickens on hover, pointer
    // cursor). Appearance only — clicking is a no-op until a topic is
    // wired up. Must match the sentence above exactly; a phrase that
    // isn't found just renders as plain prose.
    "linkPhrase": "76% to quota",
    "quotaPercent": 76,
    "quarterDaysRemaining": 30,
    "atRiskDeals": {
      "count": 3,
      "valueUsd": 420000,
      "valueLabel": "$420K"
    },
    "reEngagedBuyers": { "count": 2 },
    "upcomingMeetings": { "count": 3 },
    // Insight popovers for briefing links. One entry per topic that
    // opens a hover / focus / tap popover with more context. The
    // topicId MUST match the trigger link's `data-sh-briefing-topic`
    // attribute in home.html — that's how the JS controller binds
    // the popover to its trigger. Additional briefing links (quota,
    // re_engaged_buyers, upcoming_meetings) get popovers by adding
    // an entry here — no template or JS changes needed.
    //
    // Shape (contract for the `briefingInsightPopover` macro):
    //   • topicId          — trigger id (data-sh-briefing-topic value)
    //   • ariaLabel        — accessible name for the dialog (short)
    //   • description      — one-line intro sentence above the list
    //   • items[]          — { id, name, value, detail } rows in the body
    //     • name           — semibold left label (deal / entity name)
    //     • value          — optional muted metric ($, %, count) shown
    //                        between name and detail
    //     • detail         — muted rest-of-line (e.g. reason / status)
    //     The macro joins present fields with " · " so raw data stays
    //     free of typographic dots. A row with only { name } renders as
    //     just the semibold name; a row with { name, detail } renders
    //     "Name · detail".
    //   • primaryAction    — { id, label } → brand button (rightmost)
    //   • secondaryAction  — { id, label } → text-link button (left)
    //
    // Actions dispatch a `sh:briefing-popover-action` CustomEvent
    // with `{ topicId, action }` so a future consumer can hook up
    // real routing without touching this file.
    "popovers": [
      {
        "topicId": "at_risk_deals",
        "ariaLabel": "At-risk deals",
        "description": "These deals have slipped past their expected close dates but continue to show engagement.",
        "items": [
          { "id": "ramp",   "name": "Ramp",   "value": "$135K", "detail": "No response in 12 days" },
          { "id": "deel",   "name": "Deel",   "value": "$180K", "detail": "Legal review stalled" },
          { "id": "podium", "name": "Podium", "value": "$105K", "detail": "Pricing concern" }
        ],
        "secondaryAction": { "id": "setup_workflow", "label": "Set up a workflow" },
        "primaryAction":   { "id": "review_deals",   "label": "Review Deals" }
      }
    ]
  },
  "composer": {
    // First prompt is the one conv-002 answers, so the demo path is the
    // one the placeholder suggests. The rest still cycle.
    "placeholder": "Try \u201cWhat are the top 3 things I must know to make my number?\u201d",
    "ariaLabel": "Ask Agentforce",
    // Where Send goes. The typed text rides along as `?q=`, which the
    // conversation page echoes as the seller's first message before
    // its opening sequence plays — so asking here and drilling in from
    // a review card land on the same surface by different doors.
    // Drop this field and the composer falls back to dispatching
    // `sh:composer-submit` without navigating.
    "submitTarget": "/home_conversation.html?id=conv-002",
    "samplePrompts": [
      "Try \u201cWhat are the top 3 things I must know to make my number?\u201d",
      "Try \u201cWho should I follow up with?\u201d",
      "Try \u201cDraft an outreach for Acme.\u201d",
      "Try \u201cSummarize this week\u2019s pipeline.\u201d",
      "Try \u201cWhich deals are at risk?\u201d",
      "Try \u201cFind prospects like Northwind.\u201d"
    ],
    "actions": {
      "start": [
        { "id": "add",          "label": "Add",              "icon": "add" },
        { "id": "quick_action", "label": "Quick action",     "icon": "fallback" },
        { "id": "skills",       "label": "Skills and tools", "icon": "apps" }
      ],
      "end": [
        { "id": "voice",        "label": "Voice input",      "icon": "unmuted" }
      ]
    }
  },
  // Left-nav primary group (rendered by _home_left_nav.html).
  // Order = display order. Rows below "Knowledge" render as the same
  // primary items; "Recents" is a separate section rendered inside
  // the scroll region (see .seller-home__nav-section in home.scss)
  // with extra top padding to give it the vertical separation the
  // new design calls for between "Tools" and "Recents".
  //
  // Icon sourcing rules — same contract renderNavItem enforces:
  //   • `icon`      → SLDS utility-sprite symbol id
  //                   (/assets/icons/utility-sprite/svg/symbols.svg#…)
  //   • `iconImage` → bespoke raster (used when no suitable sprite
  //                   exists). Skips the currentColor tint so hover/
  //                   active states don't re-color the glyph.
  //
  // Item-by-item notes:
  //   • new_chat — untouched from the previous nav. Sprite `add`.
  //   • schedules — standalone row that opens /scheduled.html. Uses
  //                 the `date_time` sprite explicitly (not `clock`,
  //                 which is reserved for the Recents section
  //                 header). The Scheduled page reuses the shared
  //                 `.seller-home` shell + this exact nav via
  //                 `_home_left_nav.html`; `_template.html` keeps
  //                 the Home context-bar tab lit on `currentPage ==
  //                 'scheduled'` so drilling in from Home doesn't
  //                 lose the top-level tab.
  //   • skills   — same "Skills" label the previous nav shipped, but
  //                 the icon is the raster that used to sit on the
  //                 combined "Workflows/Scheduled" row. Per spec the
  //                 Skills row must keep that exact icon; the earlier
  //                 utility-sprite `education` glyph is dropped.
  //   • knowledge — untouched. Real route to /knowledge.html; the
  //                 detail page and _template.html's Home-tab rule
  //                 both key off `id: "knowledge"`.
  //   • tools    — new standalone row. Uses the utility sprite
  //                 `custom_apps`, which — despite its misleading
  //                 name — is the SLDS 2 wrench glyph (a diagonal
  //                 wrench with a C-shaped jaw). Salesforce reuses
  //                 this sprite anywhere a "customize / tools"
  //                 affordance is needed. Verified against
  //                 src/assets/icons/utility-sprite/svg/symbols.svg
  //                 by rendering the path directly; the plain-name
  //                 candidates (`type_tool` = letter-A typography
  //                 tool, `settings`/`setup` = gears, `builder` =
  //                 layout columns) all miss the target shape.
  //                 No `href` yet; placeholder behavior via
  //                 `data-sh-nav-noroute`, same pattern used for
  //                 other unrouted items.
  "navPrimary": [
    { "id": "new_chat",  "label": "New chat",  "icon": "add" },
    { "id": "schedules", "label": "Scheduled", "icon": "date_time", "href": "/scheduled.html" },
    { "id": "skills",    "label": "Skills",    "iconImage": "/assets/images/nav-icons/workflows.png" },
    { "id": "knowledge", "label": "Knowledge", "icon": "knowledge_base", "href": "/knowledge.html" },
    { "id": "tools",     "label": "Tools",     "icon": "custom_apps" }
  ],
  "recents": [
    {
      "id": "rec-conv-002",
      "label": "Pipeline reality check",
      "conversationId": "conv-002"
    },
    {
      "id": "rec-conv-001",
