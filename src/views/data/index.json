    //
    // Written against one question — "What are the top 3 things I must
    // know to make my number?" — because that's the demo. `?q=` puts the
    // seller's actual words at the top of the thread and in the header;
    // this is the agent's side of it. Typing something else still works,
    // it just gets this answer.
    //
    // The three findings use the `insight` message type: a ranked
    // headline with a triage dot, the evidence under it, and the
    // takeaway. Prose fields accept `**bold**` and `_italic_` (see the
    // `emphasis` filter in gulpfile.js), so the copy stays readable
    // here instead of carrying HTML.
    "conv-002": {
      "id": "conv-002",
      "title": "Pipeline reality check",
      "subtitle": "Pipeline Review",
      "workflow": { "id": "pipeline_review", "label": "Pipeline Review" },
      "status": "in_progress",
      "recentLabel": "Pipeline reality check",
