  // Two-variant empty state.
  //   • `tab`      — LIVE. Rendered when the active ownership tab
  //                   has zero skills in the dataset (e.g. "Shared
  //                   with me" on a fresh account). Copy is
  //                   author-focused: points the user toward
  //                   creating / accepting a shared skill.
  //   • `filtered` — DORMANT. Would fire when the tab has skills
  //                   but state/tool filters trim the visible set
  //                   to zero. Not reachable today because the
  //                   filter popover was withdrawn 2026-07-31 and
  //                   the state facet was removed 2026-08-03 (state
  //                   is no longer a skill concept — see the
  //                   Skill / RecentChat split note at the top of
  //                   this file). Kept so re-introducing tool /
  //                   ownership facet filters restores the two-
  //                   variant pattern with no template edit.
  "emptyState": {
    "tab": {
      "title":       "No skills here yet",
      "description": "Create a skill or add one shared by your team."
    },
    "filtered": {
      "title":       "No skills match these filters",
      "description": "Adjust or clear your filters to see more skills."
    }
  }
