      "lastRunAt":     "Aug 1 at 7:00 AM",
      "chatId":        ""
    }
  ],
  // Side-panel config. The details panel is bespoke (Frequency /
  // Delivery / Uses Skill / Instructions / Created / Last run — see the
  // partial), so this block only carries the header overflow-menu action
  // set and the routes the panel links out to. The controller shows
  // Pause OR Resume for the current status, and hides Open Chat / Last
  // run links when the schedule has no `chatId` / `lastRunId`.
  "panel": {
    "menuActions": [
      { "id": "run_now",   "label": "Run now",  "icon": "play"        },
      { "id": "pause",     "label": "Pause",    "icon": "pause"       },
      { "id": "resume",    "label": "Resume",   "icon": "play"        },
      { "id": "open_chat", "label": "Open Chat", "icon": "socialshare" },
      { "id": "archive",   "label": "Archive",  "icon": "archive"     }
    ],
    "skillRoute": "/skill_detail.html",
    "chatRoute":  "/home_conversation.html"
  },
  // Per-card overflow (⋮) actions. Dispatch `sh:workflow-action`.
  "rowActions": [
    { "id": "edit",    "label": "Edit",    "icon": "edit"    },
    { "id": "run_now", "label": "Run now", "icon": "play"    },
    { "id": "pause",   "label": "Pause",   "icon": "pause"   },
    { "id": "resume",  "label": "Resume",  "icon": "play"    },
    { "id": "archive", "label": "Archive", "icon": "archive" }
  ],
  "filterAction": {
    "id":       "filter",
    "label":    "Filter schedules",
    "icon":     "filterList"
  },
  // Toolbar overflow (⋮) menu, right of the filter control. Holds the
  // Archived view entry (authored under `tabs.overflow`); dispatched by
  // bindScheduled().
  "overflowAction": {
    "id":    "overflow",
    "label": "More views",
    "icon":  "threedots_vertical"
  },
  "emptyState": {
    "title":       "No schedules match this filter",
    "description": "Switch to another tab to see schedules in a different state."
  }
}
