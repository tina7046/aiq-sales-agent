// Scheduled shared chrome (tabs, panel, empty state).
// Workflow records live in src/views/data/users/<id>/scheduled.json.
{
  "pageTitle": "Scheduled",
  "header": {
    "heading": "Scheduled"
  },
  "composer": {
    "placeholder": "Schedule a task",
    "ariaLabel": "Schedule a task",
    "samplePrompts": [],
    "actions": {
      "start": [
        {
          "id": "add",
          "label": "Add",
          "icon": "add"
        },
        {
          "id": "skills",
          "label": "Skills",
          "iconImage": "/assets/images/nav-icons/skills.png"
        },
        {
          "id": "all_tools",
          "label": "All tools",
          "icon": "all"
        }
      ],
      "end": []
    }
  },
  "tabs": {
    "defaultTabId": "active",
    "items": [
      {
        "id": "active",
        "label": "Active",
        "statuses": [
          "completed",
          "running",
          "scheduled"
        ]
      },
      {
        "id": "paused",
        "label": "Paused",
        "statuses": [
          "paused"
        ]
      }
    ]
  },
  "statusTypes": {
    "failed": {
      "label": "Needs attention",
      "action": "Retry"
    },
    "running": {
      "label": "Running now",
      "action": "Stop"
    },
    "completed": {
      "label": "Completed",
      "action": "Run"
    },
    "scheduled": {
      "label": "Scheduled",
      "action": "Run"
    },
    "paused": {
      "label": "Paused",
      "action": "Resume"
    },
    "archived": {
      "label": "Archived",
      "action": "Restore"
    }
  },
  "workflows": [],
  "panel": {
    "menuActions": [
      {
        "id": "run_now",
        "label": "Run now",
        "icon": "play"
      },
      {
        "id": "pause",
        "label": "Pause",
        "icon": "pause"
      },
      {
        "id": "resume",
        "label": "Resume",
        "icon": "play"
      },
      {
        "id": "open_chat",
        "label": "Open Chat",
        "icon": "socialshare"
      }
    ],
    "skillRoute": "/skill_detail.html",
    "chatRoute": "/home_conversation.html"
  },
  "rowActions": [
    {
      "id": "edit",
      "label": "Edit",
      "icon": "edit"
    },
    {
      "id": "run_now",
      "label": "Run now",
      "icon": "play",
      "onlyForState": "scheduled paused"
    },
    {
      "id": "pause",
      "label": "Pause",
      "icon": "pause",
      "onlyForState": "completed scheduled running"
    },
    {
      "id": "resume",
      "label": "Resume",
      "icon": "play",
      "onlyForState": "paused"
    }
  ],
  "emptyState": {
    "title": "No schedules match this filter",
    "description": "Switch to another tab to see schedules in a different state."
  }
}
