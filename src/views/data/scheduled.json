    {
      "id":            "wf-all-hands-meeting-prep",
      "title":         "All-Hands Meeting Preparation Brief",
      "cadence":       "Paused · Previously ran weekdays at 8:00 AM",
      "status":        "paused",
      "frequency":     "Weekdays",
