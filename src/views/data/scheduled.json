// Seller Home — Scheduled workflows
// =====================================================================
// Data source for /scheduled.html. Read at build time by
// gulpfile.js:getData() because the filename matches the .html stem.
//
// Sections:
//   • pageTitle     — accessible name for the right-column <main>.
//   • header        — visible <h1>.
//   • banner        — shared educational-banner block.
//   • composer      — DORMANT (kept shape-parallel to index.json).
//   • tabs          — visible filter chips (Active / Need Attention /
//                     Paused) plus `overflow` entries (Archived) that
//                     render inside the toolbar's ⋮ menu instead of the
//                     tab row. Each carries `statuses[]` (the workflow
//                     statuses it matches; empty → match all).
//   • statusTypes   — semantic status registry, one entry per
//                     `workflow.status`. `label` is the SR-friendly
//                     name; `action` is the status-button verb.
//   • workflows     — the schedule cards. The card shows only status +
//                     name + cadence; everything else lives under
//                     `details` and surfaces in the side panel.
//   • panel         — side-panel field order/labels + the action set.
//   • rowActions    — per-card overflow (⋮) actions.
//   • filterAction  — toolbar filter icon-button.
//   • emptyState    — copy when a tab filters to zero.
{
  "pageTitle": "Scheduled",
  "header": {
    "heading": "Scheduled"
  },
  "banner": {
    "title":       "Put your recurring tasks on a schedule",
    "description": "Let Agentforce Coworker handle recurring work, like daily pipeline summaries or weekly project updates. Choose what runs and when, then share schedules with your team.",
    "imageSrc":    "/assets/images/skills-banner.jpg"
  },
  "composer": {
    "placeholder": "Schedule a task",
    "ariaLabel": "Schedule a task",
    "samplePrompts": [],
    "actions": {
      "start": [
        { "id": "add",       "label": "Add",       "icon": "add" },
        { "id": "skills",    "label": "Skills",    "iconImage": "/assets/images/nav-icons/skills.png" },
        { "id": "all_tools", "label": "All tools", "icon": "all" }
      ],
      "end": []
    }
  },
  // Visible tabs + the overflow bucket. "Active" gathers every enabled
  // schedule, which includes the one currently running (Running is a
  // transient execution state of an Active schedule, not its own tab).
  // "Archived" is reachable only from the toolbar ⋮ menu — it filters
  // the same list, so it's authored here beside the visible tabs with
  // an `icon` the menu renders.
  "tabs": {
    "defaultTabId": "active",
    "items": [
      { "id": "active",         "label": "Active",         "statuses": ["scheduled", "running", "completed"] },
      { "id": "need_attention", "label": "Needs Attention", "statuses": ["failed"] },
      { "id": "paused",         "label": "Paused",         "statuses": ["paused"] }
    ],
    "overflow": [
      { "id": "archived", "label": "Archived", "statuses": ["archived"], "icon": "archive" }
    ]
  },
  // Status registry. `failed` is the "needs attention" state and paints
  // the red warning glyph; `running` paints the animated spinner;
  // `scheduled` the clock; `paused` the pause bars; `archived` the
  // archive box (shown in the archived view). Glyph mapping lives in
  // home.scss.
  "statusTypes": {
    "failed":    { "label": "Needs attention", "action": "Retry"   },
    "running":   { "label": "Running now",     "action": "Pause"   },
    "completed": { "label": "Completed",       "action": "Pause"   },
    "scheduled": { "label": "Scheduled",       "action": "Pause"   },
    "paused":    { "label": "Paused",          "action": "Resume"  },
    "archived":  { "label": "Archived",        "action": "Restore" }
  },
  // Schedule cards. `title` is the unique schedule name (NOT the
  // reusable Skill). `cadence` is the single muted meta line. `details`
  // feeds the side panel; `conversationId` (when present) enables the
  // panel's "Open conversation" action.
  //
  // Two schedules below deliberately share one Skill (Daily Pipeline
  // Snapshot) with different cadence/scope/delivery — proof that one
  // reusable Skill backs many independently configured schedules.
  //
  // Each schedule carries the full detail model the side panel needs
  // (`_schedule_side_panel.html`): frequency/time/timezone drive the
  // Frequency row; `delivery` the Delivery line; `skillId`/`skillName`
  // the Uses-Skill chip (which links to the Skill details route);
  // `instructions` the editable Instructions box; `createdAt`/
  // `createdBy` the Created line; `lastRunId`/`lastRunStatus`/
  // `lastRunAt` the Last-run line (interactive when `lastRunId` is set,
  // jumping into `chatId` at that run). `title` is the schedule NAME
  // (never the Skill name); `cadence` is the single card meta line.
  "workflows": [
    {
      "id":            "wf-east-coast-morning-brief",
      "title":         "Daily East Coast Pipeline Snapshot",
      "cadence":       "Weekdays at 8:00 AM · Next run tomorrow",
      "status":        "scheduled",
      "frequency":     "Weekdays",
      "time":          "8:00 AM",
      "timezone":      "ET",
      "nextRun":       "Tomorrow at 8:00 AM",
      "delivery":      "#east-coast-sales on Slack",
      "skillId":       "skill-daily-pipeline-snapshot",
      "skillName":     "Daily Pipeline Snapshot",
      "instructions":  "Review the East Coast sales pipeline and identify the most important changes since the previous run. Highlight opportunities that were created, advanced, stalled, pushed out, or became at risk. Prioritize high-value deals and opportunities closing this quarter.\n\nSummarize overall pipeline coverage, notable stage changes, upcoming close dates, key risks, and recommended follow-up actions. Only include information supported by current CRM data, and clearly flag missing or outdated fields.\n\nKeep the update concise and post it to the #east-coast-sales Slack channel.",
      "createdAt":     "1st Jan 4:00PM",
      "createdBy":     "You",
      "lastRunId":     "run-east-coast-0901",
      "lastRunStatus": "Completed",
      "lastRunAt":     "today at 8:00 AM",
      "chatId":        "conv-daily-pipeline-snapshot"
    },
    {
      "id":            "wf-weekly-pipeline-leadership-recap",
      "title":         "Weekly Pipeline Leadership Recap",
      "cadence":       "Fridays at 3:00 PM · Next run Friday",
      "status":        "scheduled",
      "frequency":     "Fridays",
      "time":          "3:00 PM",
      "timezone":      "ET",
      "nextRun":       "Friday at 3:00 PM",
      "delivery":      "Sales Leadership via email",
      "skillId":       "skill-daily-pipeline-snapshot",
      "skillName":     "Daily Pipeline Snapshot",
      "instructions":  "Summarize the company-wide pipeline for sales leadership. Call out week-over-week movement, notable stage changes, and the deals most likely to close this quarter.\n\nFlag risks and coverage gaps, and recommend where leadership attention will move the number most. Keep it to an executive-length brief and email it to Sales Leadership.",
      "createdAt":     "30th Jul 9:15AM",
      "createdBy":     "You",
      "lastRunId":     "run-weekly-recap-0829",
      "lastRunStatus": "Completed",
      "lastRunAt":     "last Friday at 3:00 PM",
      "chatId":        "conv-daily-pipeline-snapshot"
    },
    {
      "id":            "wf-daily-cold-prospecting",
      "title":         "Daily Cold Prospecting",
      "cadence":       "Running now · Started at 9:00 AM",
      "status":        "running",
      "frequency":     "Weekdays",
      "time":          "9:00 AM",
      "timezone":      "PT",
      "nextRun":       "Tomorrow at 9:00 AM",
      "delivery":      "Creates tasks in Salesforce",
      "skillId":       "skill-cold-prospecting",
      "skillName":     "Cold Prospecting Outreach",
      "instructions":  "Identify net-new accounts that fit the ICP and haven't been contacted. Draft a first-touch outreach task for each, prioritized by fit and buying signals.\n\nCreate the tasks in Salesforce and keep the queue to a manageable daily volume.",
      "createdAt":     "5th Aug 11:00AM",
      "createdBy":     "You",
      "lastRunId":     "",
      "lastRunStatus": "Running",
      "lastRunAt":     "today at 9:00 AM",
