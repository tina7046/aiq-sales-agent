    },
    {
      "id":            "wf-daily-priority-buyer-outreach",
      "title":         "Daily Priority Buyer Outreach",
      "cadence":       "Slack connection expired",
      "reconnect":     {
        "message":     "Slack connection expired",
        "description": "This schedule couldn’t deliver today’s update and won’t run again until Slack is reconnected.",
        "label":       "Reconnect",
        "linkLabel":   "Reconnect Slack",
        "ariaLabel":   "Reconnect Slack for Daily Priority Buyer Outreach"
      },
      "status":        "failed",
      "frequency":     "Weekdays",
      "time":          "8:30 AM",
      "timezone":      "PT",
