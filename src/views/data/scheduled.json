      "instructions":  "Assemble the all-hands agenda with the latest metrics and highlights. Email the brief to me the morning of the meeting.",
      "createdAt":     "15th Jun 4:20PM",
      "createdBy":     "You",
      "lastRunId":     "",
      "lastRunStatus": "Completed",
      "lastRunAt":     "Aug 28 at 8:00 AM",
