// Seller Home — Scheduled workflows
// =====================================================================
// Data source for /scheduled.html. Read at build time by
// gulpfile.js:getData() because the filename matches the .html stem.
//
// Sections:
//   • pageTitle     — accessible name for the right-column `<main>`
//                     region and the document title. Kept parallel
//                     to knowledge.json for consistency.
//   • header        — text above the body.
//                       - heading      → the visible `<h1>`
//                     (The prior `description` intro paragraph was
//                     retired when the page adopted the shared
//                     educational banner — its copy now lives in
//                     `banner.description` below.)
//   • banner        — shared educational-banner block. Same shape
//                     Skills uses; rendered by the shared partial
//                     `_seller_home_banner.html`. See that file for
//                     field-level docs. `banner.title` must be
//                     non-empty for the include to render.
//   • composer      — DORMANT (mirrors the Skills precedent). Kept
//                     as-is so re-adding the chat surface is a one-
//                     line template edit; no live consumer today.
//                     Shape stays parallel to index.json's
//                     `composer`.
//   • tabs          — filter chips + counts across the workflow list.
//                       - id           → filter key wired to `status`
//                       - label        → visible label
//                       - statuses[]   → status values that pass this
//                                        filter (empty → "match all")
//                     `defaultTabId` selects which tab paints active
//                     on first paint; JS hydrates from URL hash if
//                     one is present. Counts are recomputed by JS on
//                     load so they never drift when the workflow list
//                     is edited.
//   • statusTypes   — semantic status registry. Each entry:
//                       - label        → screen-reader-friendly name
//                       - action       → verb for the status button's
//                                         accessible name ("Pause
//                                         Buyer Engage"), i.e. what a
//                                         click does from this state
//                     Keys are the `status` values referenced by each
//                     workflow row, and they're the home feed's five
//                     states verbatim ("completed" | "running" |
//                     "scheduled" | "paused" | "failed") — the two
//                     surfaces share one status control, so they have
//                     to share its vocabulary. Which glyph each state
//                     paints is decided in home.scss, not here.
//   • workflows     — the rows. Each entry:
//                       - id           → stable dom + event key
//                       - title        → semibold 14 px name
//                       - cadence      → 12 px muted meta line
//                       - status       → key into statusTypes
//                       - linked       → optional; `false` opts the
//                                         row out of drill-in (the
//                                         template renders it as an
//                                         inert `<div>` with no
//                                         chevron affordance).
//   • rowActions    — overflow-menu (⋮) actions per workflow. Dispatch
//                     `sh:workflow-action` on click; a future
//                     scheduler backend can listen.
//   • filterAction  — the top-right filter icon-button. Same
//                     dispatch pattern — click emits
//                     `sh:scheduled-filter` for a future consumer.
//   • emptyState    — copy shown when a tab filter has zero matches
//                     (rendered by the list partial's sibling block,
//                     toggled by JS).
{
  "pageTitle": "Scheduled",
  "header": {
    "heading": "Scheduled"
  },
  // Shared educational banner (see `_seller_home_banner.html`).
  // Copy mirrors the Skills banner's tone/length so the two landing
  // pages read as a matched pair. Same illustration asset as Skills
  // for now — the mascot artwork is generic to Seller Home and no
  // Scheduled-specific composition exists yet. Dropping in a
  // Scheduled-specific illustration is a one-line JSON edit.
  //
  // This block replaced the prior `header.description` intro
  // paragraph, whose copy the banner now carries.
  "banner": {
    "title":       "Put your recurring tasks on a schedule",
    "description": "Let Agentforce Coworker handle recurring work, like daily pipeline summaries or weekly project updates. Choose what runs and when, then share schedules with your team.",
    "imageSrc":    "/assets/images/skills-banner.jpg"
  },
  // Composer — DORMANT since the page adopted the shared banner
  // (mirrors the Skills precedent). No live consumer: scheduled.html
  // no longer includes `_home_composer.html`. Kept as-is, and kept
  // shape-parallel to index.json's `composer`, so re-adding the chat
  // surface is a one-line template edit.
  "composer": {
    "placeholder": "Schedule a task",
    "ariaLabel": "Schedule a task",
    "samplePrompts": [],
    // Same trio, same order, same sources as the Home composer in
    // index.json — one composer component, so a change there is a change
    // here. `end` is empty; the mic is gone from both.
    "actions": {
      "start": [
        { "id": "add",       "label": "Add",       "icon": "add" },
        { "id": "skills",    "label": "Skills",    "iconImage": "/assets/images/nav-icons/skills.png" },
        { "id": "all_tools", "label": "All tools", "icon": "all" }
      ],
      "end": []
    }
  },
  // Tabs. Counts are computed client-side from `workflows[]` by
  // bindScheduled() in home.js so the JSON never has to hand-track
  // them. `statuses: []` on "all" means the tab matches everything.
  //
  // Errored workflows are promoted out of the "Scheduled" bucket into
  // their own "Need attention" tab — the surface's most actionable
  // state, so the design elevates it. Default tab is "all" so a seller
  // with mixed workflows lands on the fullest picture rather than an
  // initially-empty "Need attention" tab.
  //
  // "Scheduled" covers every workflow in a healthy cadence, which
  // includes the ones mid-run and the ones whose last run finished:
  // all three are on the same schedule, they're just at different
  // points in it. Splitting them out would put a workflow in a
  // different tab depending on the minute you looked, and leave rows
  // reachable from no tab but "All".
  "tabs": {
    "defaultTabId": "all",
    "items": [
      { "id": "all",            "label": "All",            "statuses": [] },
      { "id": "need_attention", "label": "Need attention", "statuses": ["failed"] },
      { "id": "scheduled",      "label": "Scheduled",      "statuses": ["scheduled", "running", "completed"] },
      { "id": "paused",         "label": "Paused",         "statuses": ["paused"] }
    ]
  },
  // Status registry — one entry per `workflow.status` value, matching
  // the home feed's states so a workflow reads the same on both
  // surfaces. The glyph each state paints lives in home.scss (one
  // mapping, shared with the feed); this block only carries copy.
  //
  // `action` is what the status button offers from that state, which
  // is why `failed` says "Retry" rather than "Pause": what the seller
  // came to an errored workflow for is to run it again.
  "statusTypes": {
    "failed":    { "label": "Needs attention", "action": "Retry"  },
    "running":   { "label": "Running now",     "action": "Pause"  },
    "completed": { "label": "Completed",       "action": "Pause"  },
    "scheduled": { "label": "Scheduled",       "action": "Pause"  },
    "paused":    { "label": "Paused",          "action": "Resume" }
  },
  // Workflows. A row drills in when it has somewhere to go: drop the
  // `linked: false` and give it an `href`, and the row macro renders it
  // as an `<a>` instead of an inert `<div>`.
  //
  // Daily Pipeline Snapshot is the one wired up so far. Its `href`
  // points at the conversation carrying the matching `workflowContext`
  // block (index.json → conversations), which is what puts the
  // run-history side panel beside that thread. The remaining rows stay
  // `linked: false` until they have a conversation of their own.
  //
  // The states below are spread so every one the status button can
  // paint is on screen at once — this is a prototype and the list is
  // the only place to see them. Re-pointing a row at another state is
  // a one-word edit; nothing in the template, CSS or JS is keyed to
  // which row holds which.
  "workflows": [
    {
      "id":      "wf-daily-pipeline-snapshot",
      "title":   "Daily Pipeline Snapshot",
      "cadence": "Daily at 9:00 AM PST",
      "status":  "failed",
      "linked":  true,
      "href":    "/home_conversation.html?id=conv-daily-pipeline-snapshot"
    },
    // Weekly Top 3 Things is the run-history surface: five runs of the
    // same workflow appended into one thread, navigated from the header's
    // Run History dropdown rather than a side panel. Its conversation
    // carries `runHistory` (not `workflowContext`), which is what keeps
    // the panel off that thread — see index.json → conv-weekly-top-3.
    {
      "id":      "wf-weekly-top-3",
      "title":   "Weekly Top 3 Things",
      "cadence": "Weekly on Monday at 9:00 AM PST",
      "status":  "completed",
      "linked":  true,
      "href":    "/home_conversation.html?id=conv-weekly-top-3"
    },
    {
      "id":      "wf-daily-deal-summary",
      "title":   "Daily Deal Summary",
      "cadence": "Daily at 9:30 AM PST",
      "status":  "running",
      "linked":  false
    },
    {
      "id":      "wf-buyer-engage",
      "title":   "Buyer Engage",
      "cadence": "Daily at 9:30 AM PST",
      "status":  "completed",
      "linked":  false
    },
    {
      "id":      "wf-prepare-for-meetings",
      "title":   "Prepare for Meetings",
      "cadence": "Daily at 9:30 AM PST",
      "status":  "scheduled",
      "linked":  false
    },
    {
      "id":      "wf-cold-prospecting",
      "title":   "Cold Prospecting",
      "cadence": "Daily at 9:30 AM PST",
      "status":  "scheduled",
      "linked":  false
    },
    {
      "id":      "wf-stay-in-touch-outreach",
      "title":   "Stay in Touch Outreach",
      "cadence": "Paused",
      "status":  "paused",
      "linked":  false
    }
  ],
  // Per-row overflow menu (⋮). Actions dispatch `sh:workflow-action`
  // CustomEvent with `{ workflowId, actionId }` so a future
  // scheduler backend can bind without touching this markup.
  // Keeping Pause / Resume as two entries rather than a toggle so
  // the row can decide which one to show based on the current
  // status. For now the template renders both; a future increment
  // can hide the inapplicable one.
  "rowActions": [
    { "id": "edit",      "label": "Edit",      "icon": "edit"      },
    { "id": "pause",     "label": "Pause",     "icon": "pause"     },
    { "id": "resume",    "label": "Resume",    "icon": "play"      },
    { "id": "duplicate", "label": "Duplicate", "icon": "copy"      },
    { "id": "delete",    "label": "Delete",    "icon": "delete"    }
  ],
  // Right-anchored filter button next to the tabs. Icon-only,
  // circular, brand-blue funnel glyph. Click emits
  // `sh:scheduled-filter` — a future consumer can open a filter
  // menu without changes here.
  "filterAction": {
    "id":       "filter",
    "label":    "Filter workflows",
    "icon":     "filterList"
  },
  // Empty state — rendered as a sibling of the list. Hidden by
  // default; bindScheduled() toggles the `hidden` attribute when
  // the active tab filters out every workflow.
  "emptyState": {
    "title":       "No workflows match this filter",
    "description": "Switch to another tab to see workflows in a different state."
  }
}
