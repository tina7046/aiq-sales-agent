    },
    {
      "id":            "wf-monthly-territory-review",
      "title":         "Monthly Territory Review",
      "cadence":       "Archived",
      "status":        "archived",
      "frequency":     "Monthly",
      "time":          "7:00 AM",
      "timezone":      "PT",
      "nextRun":       "—",
      "delivery":      "Emails you",
      "skillId":       "skill-territory-analysis",
      "skillName":     "Territory Analysis",
      "instructions":  "Review territory pipeline health and coverage. Summarize movement and risks, and email the review to me on the first Monday of the month.",
