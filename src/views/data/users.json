// Prototype seller catalog
// =====================================================================
//   defaultUserId  — `/` and leftover `/index.html` redirect here.
//   users[]         — { id, name, title, avatar }
//                     `id` is the URL prefix: /u/<id>/index.html
//
// Page records (feed, knowledge, skills, scheduled) live in
// src/views/data/users/<id>/*.json and are merged onto the shared
// chrome files in src/views/data/. A non-default overlay file
// replaces the default pack for that page.
{
  "defaultUserId": "rohan",
  "users": [
    {
      "id": "rohan",
      "name": "Rohan",
      "title": "Account Executive",
      "avatar": "/assets/images/avatar2.jpg"
    },
    {
      "id": "nima",
      "name": "Nima",
      "title": "Admin",
      "avatar": "/assets/images/avatar-nima.png"
    }
  ]
}
