{
  // ══════════════════════════════════════════════════════════════════
  //  "Your agent at work" — PROTOTYPE data
  //  ------------------------------------------------------------------
  //  Seeded from `feed.*` in index.json. It is a SEPARATE file on
  //  purpose: reshaping the row contract here (new fields, new output
  //  shapes) can't break the live Seller Home page.
  //
  //  Gulp injects this automatically — `getData` in gulpfile.js reads
  //  `data/<page>.json` for `<page>.html`, so this file is the data for
  //  agent_at_work.html. JSON5, so comments and trailing commas are fine.
  //
  //  When the new iteration is settled, fold the changed keys back into
  //  index.json's `feed` block.
  // ══════════════════════════════════════════════════════════════════
  "aaw": {
    "heading": "Your agent at work",
    // null = stamp today's date at build time and re-stamp on load.
    // Set a literal string ("Mon July 13") to freeze it for a screenshot.
    "date": null,

    "overflowActions": [
      { "id": "view_all",        "label": "View all" },
      { "id": "review_settings", "label": "Review settings" }
    ],

    // Shared per-card kebab actions. The run control leads — it's the
    // one a seller reaches for — and dismiss is the destructive one, so
    // it sits at the bottom where it's harder to hit by accident.
    //
    // `onlyForState` / `hideForState` scope an action to the states it
    // makes sense in, and they're enforced in CSS off the row's
    // `data-aaw-state` rather than at render time — a row can change
    // state while its menu already exists. Here that means the top item
    // reads "Run now" on every row except a running one, which offers
    // "Pause" in the same slot instead.
    //
    // Both start or stop a run off-schedule, and both reuse transitions
    // the status button already makes, so nothing here is a second way
    // of doing something that already had one.
    "rowActions": [
      { "id": "run_now", "label": "Run now", "icon": "play",  "hideForState": "running" },
      { "id": "pause",   "label": "Pause",   "icon": "pause", "onlyForState": "running" },
      { "id": "dismiss", "label": "Dismiss", "icon": "close" }
    ],

    // Semantic category → glyph. `sprite` + `spriteFamily` render an
    // inline <svg><use>; `iconImage` renders an <img> and wins if both
    // are set. Doctype sprites are pre-colored, so the pill CSS does
    // not force a currentColor fill.
    "outputTypes": {
      "table":    { "sprite": "gsheet", "spriteFamily": "doctype" },
      "doc":      { "sprite": "gdoc",   "spriteFamily": "doctype" },
      "message":  { "sprite": "txt",    "spriteFamily": "doctype" },
      "document": { "iconImage": "/assets/images/output-icons/doc.png" },
      "pdf":      { "sprite": "pdf",    "spriteFamily": "doctype" }
    },

    // ── The subline ───────────────────────────────────────────────────
    // Normalized to two slots: "<status> · <time>".
    //
    //   completed   Completed   · Next run in 3 days
    //   running     Running now · Started 4 min ago
    //   scheduled   Daily       · Next run in 15 hours
    //   paused      Paused      · Last run Thursday
    //   failed      Failed      · Last run today at 6:00 AM
    //
    // `scheduled` is the one state whose left slot isn't a status word.
    // A row that's simply waiting has no status worth naming — what you
    // want to know is how often it runs — and using the cadence there
    // also stops `scheduled` and `completed` from reading identically,
    // since both name a next run on the right.
    //
    // The labels live here rather than in the template so the wording is
    // editable without touching markup, and so the JS that rewrites the
    // subline on pause has no copy of its own.
    "statusLabels": {
      "completed": "Completed",
      "running":   "Running now",
      "paused":    "Paused",
      "failed":    "Failed"
    },

    // What the right slot says the moment a failed row is retried. The
    // retry has no history to report yet, so it can't reuse `startedAt`.
    "retryTime": "Started just now",

    // Row order. The template groups `items` by this sequence, so a new
    // row lands in the right place wherever it's added to the array
    // below — the order is a rule here, not a one-time arrangement.
    //
    // Results lead. `failed` sits directly under the last completed row
    // rather than above everything: it's still a finished run, just one
    // that didn't work, so it belongs with the other outcomes instead of
    // interrupting them.
    "stateOrder": ["completed", "failed", "running", "scheduled", "paused"],

    // ── One list, one row per recurring workflow ──────────────────────
    // The Completed / Running / Scheduled tabs are gone, so a workflow
    // is no longer three potential rows (its last result, its current
    // run, its next run) — it's one row that carries its own state.
    //
    // Row: { id, title, state, cadence, lastRun, nextRun?, startedAt?,
    //        waitingSince?, conversationId?, outputs?, workflow? }
    //   • state   — one of `stateOrder`.
    //   • cadence — how often the workflow runs ("Weekly", "Daily").
    //     Shown as the left slot on `scheduled` rows only, but carried
    //     by every row so one can be rescheduled into that state.
    //   • The time fields each serve one state's right slot:
    //       nextRun    completed, scheduled
    //       startedAt  running
    //       lastRun    paused, failed
    //     Every row needs `lastRun` regardless of state, because any row
    //     can be paused from its status button and a paused row reports
    //     when it last ran.
    //   • Each is the full display string ("Next run in 3 days"), so the
    //     template stays a plain render with no date formatting.
    //   • outputs — what the row has to show. Completed rows carry real
    //     counts, scheduled rows carry "~" estimates for a run that
    //     hasn't happened, and paused rows carry none.
    //   • outputs[].label is the full display string, so the template
    //     stays a plain render (no count / pluralization logic).
    //   • variant — which row treatment renders the item. Omitted = the
    //     v0 card. "task" = the flat 72px scheduled-task row (no card
    //     surface, no output pills, hairline rule between neighbours,
    //     inline pause/resume). Flipping a row between the two is this
    //     one field, so both can be judged in the same list.
    "items": [
      // An errored run. Without this state a failure renders as
      // "Completed" with no outputs, which is worse than saying nothing.
      //
      // `error` replaces `outputs` on a failed row: there's no artifact
      // to link to, so the space the pills would occupy carries what
      // went wrong instead, as an SLDS error badge.
      //
      // `retryOutput` is the ordinary pill that takes the badge's place
      // once the row is retried. It's a placeholder for a run that has
      // produced nothing yet — the point is that the row keeps a third
      // line, so retrying doesn't change its height.
      {
        "id": "fail-01",
        "title": "Sync territory quota changes",
        "cadence": "Daily",
        "lastRun": "Last run today at 6:00 AM",
        "state": "failed",
        "error": "Quota API returned 502 — 0 of 214 territories synced",
        "retryOutput": { "icon": "doc", "label": "Syncing 214 territories" },
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "ri-01",
        "conversationId": "conv-001",
        "title": "Found new prospects",
        "cadence": "Weekly",
        "nextRun": "Next run in 3 days",
        "lastRun": "Last run Thursday",
        "state": "completed",
        "outputs": [
          { "icon": "table",   "label": "7 accounts imported" },
          { "icon": "message", "label": "25 prospects" }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "run-01",
        "title": "Researching 42 target accounts",
        "cadence": "Weekly",
        "startedAt": "Started 12 min ago",
        "lastRun": "Last run Monday",
        "state": "running",
        "outputs": [
          { "icon": "table", "label": "42 accounts" }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "ri-02",
        "title": "Drafted proposals to send",
        "cadence": "Daily",
        "nextRun": "Next run tomorrow at 6:00 AM",
        "lastRun": "Last run today",
        "state": "completed",
        "outputs": [
          { "icon": "pdf", "label": "10 proposals" }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "run-02",
        "title": "Drafting outreach for warm leads",
        "cadence": "Daily",
        "startedAt": "Started 4 min ago",
        "lastRun": "Last run yesterday",
        "state": "running",
        "outputs": [
          { "icon": "message", "label": "12 of 30 drafted" }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "ri-03",
        "title": "Prepared your weekly exec brief",
        "cadence": "Weekly",
        "nextRun": "Next run Friday at 5:00 AM",
        "lastRun": "Last run Friday",
        "state": "completed",
        "outputs": [
          // `todayPrefix` prepends the short date ("Aug 17") to the label.
          { "icon": "doc", "label": "Quarterly Deal Pulse", "todayPrefix": true }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "sch-01",
        "title": "Refresh account health scores",
        "cadence": "Monthly",
        "nextRun": "Next run Monday at 6:00 AM",
        "lastRun": "Last run Jul 20",
        "state": "scheduled",
        "outputs": [
          { "icon": "table", "label": "~1,240 accounts" }
        ],
        "workflow": { "id": "", "label": "" }
      },
      {
        "id": "sch-02",
        "title": "Summarize competitor mentions",
        "cadence": "Weekly",
        "nextRun": "Next run Friday at 7:00 AM",
        "lastRun": "Last run Friday",
        "state": "scheduled",
        "outputs": [
          { "icon": "doc", "label": "~15 call summaries" }
        ],
        "workflow": { "id": "", "label": "" }
      }
      // No rows ship in the `paused` state any more, but the state is
      // still reachable: pausing any row above puts it there at runtime,
      // which is why `stateOrder` and the paused styling stay.
      //
      // A paused row keeps a real `nextRun` rather than the literal
      // "Paused" — the row DISPLAYS "Paused" (the template substitutes
      // it), while the schedule underneath is what resuming restores.
    ]
  }
}
