{
  // ══════════════════════════════════════════════════════════════════
  //  "Your agent at work" — LAB data
  //  ------------------------------------------------------------------
  //  Seeded as an exact copy of the `feed` block in index.json, and it
  //  is the ONLY thing about /agent_at_work.html that forks from Seller
  //  Home. The markup, styles and behaviour are shared — the page
  //  includes `_home_feed.html`, loads home.css and boots home.js — so
  //  there is one implementation and it cannot drift.
  //
  //  What forks is the content: this file is the time-lapse seed for
  //  /agent_at_work.html — three weekly waves (3, then 3, then 3
  //  cards). Markup, styles and behaviour stay shared with Seller Home.
  //
  //  Gulp injects this automatically — `getData` reads
  //  `data/<page>.json` for `<page>.html` — so defining `feed` here is
  //  what makes the include pick it up. See the comments in index.json
  //  for the row contract; it is the same one.
  // ══════════════════════════════════════════════════════════════════
  "feed": {
    "heading": "Hunter at work",
    // Lab conveyor date ladder (weekdays only):
    // Wednesday, Sep 16 → Thursday, Oct 8 → Tuesday, Nov 17 → Friday, Dec 4.
    // Pin so home.js does not overwrite with the live calendar day.
    "date": "Wednesday, Sep 16",
    // ── The subline ───────────────────────────────────────────────────
    // Every row's second line is two slots: "<left> · <right>".
    //
    //   completed   Ready   · Weekly
    //   running     Running · Weekly
    //   scheduled   Daily   · Next run in 15 hours
    //   paused      Paused  · Last run Thursday
    //   failed      Failed  · Last run today at 6:00 AM
    //
    // Ready and Running both lead with the status word. The right slot
    // is cadence (`Weekly`) so a finish only swaps Ready / Running.
    // Paused / Failed / Archived still use a status word on the left.
    // Full contract: index.json `feed`.
    // ── Group headers ─────────────────────────────────────────────────
    // Labels above the runs of rows. Defining `groups` at all is what
    // turns them on, so a page can opt out by dropping the key.
    //
    // Tried here first and since ported, so index.json has the same
    // block — this is no longer what makes the lab differ from Seller
    // Home. See index.json for the full note.
    "groups": {
      "active": "Active",
      "paused": "Paused"
    },

    // ── Filter (LAB ONLY) ─────────────────────────────────────────────
    // Defining `filter` is what turns the whole feature on: the section
    // kebab becomes a Filter control, the list gets `data-sh-feed-filter`,
    // and home.js/home.scss switch on that attribute.
    //
    // Ready / Running section headings are a separate data flag:
    // `filter.sections`. Seller Home sets that in index.json. This lab
    // file omits it so the conveyor stays a flat list.
    //
    //   options   the three views, in menu order. `default` is the one
    //             the list opens on. Active is one flat list of Ready
    //             and Running rows (no section headings) because this
    //             file omits `filter.sections`. Seller Home sets that
    //             key in index.json and gets Ready / Running labels.
    "filter": {
      "default": "active",
      "options": [
        { "id": "active",    "label": "Active"    },
        { "id": "scheduled", "label": "Scheduled" },
        { "id": "archived",  "label": "Archived"  }
      ],
      // A message per view for when it has no rows — the filter's
      // equivalent of `feed.empty`. home.scss shows the matching one when
      // that view's states are all absent.
      "empty": {
        "active":    { "heading": "No active workflows",  "body": "Runs in progress and recent results show up here." },
        "scheduled": { "heading": "Nothing scheduled",     "body": "Upcoming runs will appear here." },
        "archived":  { "heading": "No archived workflows", "body": "Anything you archive lands here." }
      }
    },

    // Left-slot words. Ready and Running lead with these; cadence sits
    // on the right. Paused / Failed / Archived still use a status word
    // on the left.
    "statusLabels": {
      "completed": "Ready",
      "running":   "Running",
      "paused":    "Paused",
      "failed":    "Failed",
      "archived":  "Archived"
    },

    // Shown in place of the list once every row has been cleared, so
    // the section holds its shape instead of collapsing to a bare
    // header. Which one is visible is decided in CSS off whether any
    // rows are left, so it also covers a page that loads with none.
    "empty": {
      "heading": "You're all caught up",
      "body": "New results appear here as Hunter works."
    },

    // Unused by the feed subline (right slot is now Running / Completed
    // from `statusLabels`). Kept so older callers of `feedItem` still
    // have a value to pass.
    "retryTime": "Just started",

    // Row order. The template groups `items` by this sequence, so a new
    // row lands in the right place wherever it's added to the array
    // below, and home.js re-sorts by the same rule when a row changes
    // state at runtime.
    //
    // `failed` sits directly under the last completed row rather than
    // above everything: it's still a finished run, just one that didn't
    // work, so it belongs with the other outcomes instead of
    // interrupting them.
    "stateOrder": ["completed", "failed", "running", "scheduled", "paused", "archived"],
    "overflowActions": [
      { "id": "view_all",        "label": "View all" },
      { "id": "review_settings", "label": "Review settings" }
    ],
    // Per-row overflow-menu actions rendered by the `feedItem` macro.
    // Same { id, label, icon? } shape as `overflowActions` above so a
    // future consumer can share renderers between the section-level and
    // row-level menus. `icon` (optional) is an SLDS utility-sprite id.
    // Kept as one shared list rather than per-row overrides so every
    // card exposes the same action set — matches the Salesforce list-
    // interaction pattern where every row has an identical kebab menu.
    // Additional actions (Snooze, Assign, etc.) drop in as new entries
    // here without any template or JS changes.
    //
    // `onlyForState` / `hideForState` scope an action to the states it
    // makes sense in, and they're enforced in CSS off the row's
    // `data-sh-feed-state` rather than at render time — a row can change
    // state while its menu already exists. `onlyForState` takes a
    // space-separated list, so an action can scope to several states —
    // e.g. Run now and Archive show on completed and scheduled rows.
    //
    // Per state the menu reads:
    //   completed  Run now · Edit · Archive
    //   running    Stop · Edit
    //   scheduled  Run now · Edit · Archive
    //   archived   Restart · Edit
    "rowActions": [
      { "id": "run_now", "label": "Run now", "icon": "play",    "onlyForState": "completed scheduled" },
      { "id": "stop",    "label": "Stop",    "icon": "stop",    "onlyForState": "running" },
      { "id": "restart", "label": "Restart", "icon": "refresh", "onlyForState": "archived" },
      { "id": "edit",    "label": "Edit",    "icon": "edit" },
      { "id": "archive", "label": "Archive", "icon": "archive", "onlyForState": "completed scheduled" }
    ],
    // Semantic-category → SLDS utility-sprite map (Figma node
    // 8797:228978). Row outputs pick an `icon` from this map's
    // keys — the mapping to a concrete SLDS sprite lives here so
    // a design change that reskins "message" from `comments` to
    // `email` (or any other utility icon) is a single-line edit
    // that re-skins every message pill on the page. Categories:
    //   • table    — structured records / lists (prospects, buyers,
    //                accounts as list output)
    //   • message  — drafted outreach or replies
    //   • document — generated artifacts (briefs, next steps)
    //   • pdf      — polished, distributable reports
    //
    // Icon sourcing rules — same shape the nav item macro uses:
    //   • `sprite`        — SVG symbol id inside a `spriteFamily`
    //                        sprite. `spriteFamily` picks which
    //                        `assets/icons/<family>-sprite/svg/symbols.svg`
    //                        file to load from. Defaults to `utility`
    //                        for back-compat.
    //   • `iconImage`     — raster asset path used when no suitable
    //                        sprite exists (per-icon fallback). Wins
    //                        over `sprite` if both are set.
    //
    // Doctype sprites (`gsheet`, `txt`, `pdf`) are pre-colored — the
    // pill glyph CSS deliberately does NOT force a `currentColor`
    // fill on the SVG so these sprites paint themselves.
    "outputTypes": {
      "table":    { "sprite": "gsheet", "spriteFamily": "doctype" },
      "doc":      { "sprite": "gdoc",   "spriteFamily": "doctype" },
      "message":  { "sprite": "txt",    "spriteFamily": "doctype" },
      "document": { "iconImage": "/assets/images/output-icons/doc.png" },
      "pdf":      { "sprite": "pdf",    "spriteFamily": "doctype" },
      "doc-green": { "iconImage": "/assets/images/doctype-icons/Doc-green.svg" },
      "doc-blue":  { "iconImage": "/assets/images/doctype-icons/Doc-blue.svg" },
      "doc-grey":  { "iconImage": "/assets/images/doctype-icons/Doc-grey.svg" },
      "doc-yellow": { "iconImage": "/assets/images/doctype-icons/Doc-yellow.svg" },
      "doc-red": { "iconImage": "/assets/images/doctype-icons/Doc-red.svg" },
      "doc-purple": { "iconImage": "/assets/images/doctype-icons/Doc-purple.svg" },
      "doc-orange": { "iconImage": "/assets/images/doctype-icons/Doc-orange.svg" }
    },
    // ── Time-lapse seed (weekly waves 3 → 3 → 3 → empty) ─────────────
    // Wave 1 is visible on first paint. Waves 2–3 ship `hidden` so they
    // don't flash before the director runs; they start all Running and
    // flip Ready at 750 / 1000 / 1250ms after they land.
    "items": [
      {
        "id": "run-10",
        "title": "Populated CRM records from transcripts",
        "titles": {
          "running": "Populating CRM records from transcripts",
          "completed": "Populated CRM records from transcripts",
          "neutral": "Populate CRM records from transcripts"
        },
        "cadence": "Daily",
        "stepProgress": "3 of 3 steps",
        "startedAt": "1 min elapsed",
        "nextRun": "Next run Friday at 9:00 AM",
        "lastRun": "Last run today",
        "state": "completed",
        "outputs": [
          {
            "icon": "doc-yellow",
            "label": "1 opportunity",
            "scheduledIcon": "doc-grey",
            "scheduledLabel": "Opportunity"
          },
          {
            "icon": "doc-purple",
            "label": "1 account",
            "scheduledIcon": "doc-grey",
            "scheduledLabel": "Account"
          }
        ],
