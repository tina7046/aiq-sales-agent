// Seller Home — Learnings page data
// =====================================================================
// Consumed by src/views/learnings.html. gulpfile.js's getData() merges
// this file into that template's scope by filename.
//
// A prototype variant of the Knowledge surface: instead of a document
// list that drills into a detail page, the six Auto-Learning documents
// become pill tabs and the selected one renders in-page underneath.
// The document content itself is NOT here — it's pulled from
// knowledge.json (the same catalog the Knowledge list + detail pages
// read) so there's one source of truth for the markdown.
//
// Fields:
//   • pageTitle   (string) window title + the role="main" region's
//                 accessible name.
//   • navActive   (string) id of the active left-nav item; lights the
//                 "Learnings" entry added to index.json → navPrimary.
//   • header      (object) header-band content:
//                   - heading  (string) the H1.
{
  "pageTitle": "Learnings",
  "navActive": "learnings",
  "header": {
    "heading": "Learnings"
  }
}
