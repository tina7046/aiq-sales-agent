// Seller Home — Tools page data
// =====================================================================
// Consumed by src/views/tools.html. gulpfile.js's getData() merges this
// file into that template's scope by filename.
//
// Deliberately thin. The cards themselves are NOT here — they live in
// `shared.toolsModal` (shared.json) because the Tools modal renders the
// same catalog, and the two surfaces have to stay in lockstep. This
// file carries only the page chrome that the modal has no equivalent
// for: the browser title, the nav highlight, and the header band.
//
// Fields:
//   • pageTitle   (string) window title + the `role="main"` region's
//                 accessible name.
//   • navActive   (string) id of the active left-nav item. The
//                 renderNavItem macro in _home_left_nav.html applies
//                 `.is-active` + `aria-current="page"` when this
//                 matches item.id. "tools" matches the entry in
//                 index.json → navPrimary.
//   • header      (object) header-band content:
//                   - heading      (string) the H1.
{
  "pageTitle": "Connections",
  "navActive": "tools",
  "header": {
    "heading": "Connections"
  }
}
