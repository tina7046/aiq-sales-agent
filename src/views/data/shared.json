{
  // To access this data in a view, you'd write:
  // {{ shared.somedata }}
  "somedata": "somevalue",
  "builtWith": "Salesforce Lightning Design System Starter Kit",

  // Tools modal catalog — ported from the BB-AOP prototype's
  // Account Research step (`_tools_morph_modal.html`). Lives in
  // shared.json rather than a page data file because the modal
  // mounts on more than one surface (Seller Home + the conversation
  // drill-in), and both have to read one catalog or the card grids
  // drift apart.
  //
  // Fields per tool:
  //   - id              (string) stable DOM hook + the key the
  //                     controller uses to look up detail-panel
  //                     content. Snake_case, matches the ids in
  //                     src/scripts/tools-data.js.
  //   - name            (string) card title.
  //   - description     (string) card subtitle, one line.
  //   - icon            (string) either a sprite reference
  //                     ("<sprite>.svg#<symbol>") or a path to a
  //                     standalone asset under /assets.
  //   - iconSize        (string) SLDS icon sizing class. Sprite
  //                     glyphs and bitmap art need different sizes
  //                     to optically match, hence per-tool.
  //   - iconExtraClass  (string, optional) extra class on the icon
  //                     container; "tool-icon-center" for art that
  //                     needs centering inside the 32px box.
  //   - iconLabel       (string) assistive-text name for the icon.
  //   - state           ("added" | "setup") drives the badge — a
  //                     green check pill or an "Add" pill.
  //   - panelType       ("detail" | "zoominfo" | "conversations")
  //                     which panel the card morphs to on click.
  //                     "detail" is the generic tabbed panel and is
  //                     the right default for a new card.
  //   - category        (string) which `categories` entry the card
  //                     files under. The tab bar above the grid filters
  //                     on this. A value with no matching category
  //                     leaves the card reachable only from "All".
  "toolsModal": {
    // Filter tabs above the card grid, rendered by the shared
    // ShTabNav component (src/scripts/tab_nav.js). Order here is the
    // order on screen. "all" is special-cased by the filter to match
    // everything; every other `id` is matched against a card's
    // `category`. Add a tab and a matching category and the grid
    // picks it up with no code change.
    "categories": [
      { "id": "all",      "label": "All" },
      { "id": "crm",      "label": "CRM & Engagement" },
      { "id": "contacts", "label": "Contacts & People" },
